library(ggplot2)
# Parameters
alpha <- 5.9
beta <- 4.1
# Generate Beta sample
set.seed(123)
beta_sample <- rbeta(10000, alpha, beta)
# Adjust to [0.5, 1]
adjusted_sample <- 0.5 + 0.5 * beta_sample
# Check mean
mean(adjusted_sample)  # Should be approximately 0.59
# Plot
ggplot(data.frame(values = adjusted_sample), aes(x = values)) +
geom_histogram(bins = 30, fill = 'blue', alpha = 0.5) +
theme_minimal() +
xlim(0.5, 1) +
labs(title = "Transformed Beta Distribution")
mean(rbeta(10000, alpha, beta))
